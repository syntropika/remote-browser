+    /// Forward the visible parts of nested viewports reported by the document that
+    /// contains their `<iframe>`s. A value is only accepted from the parent pipeline of
+    /// the nested browsing context, including one whose first document is still loading.
+    /// It reaches every pipeline of that browsing context and is replayed to pipelines
+    /// that are created for it later.
+    #[servo_tracing::instrument(skip_all)]
+    fn handle_update_viewport_intersections(
+        &mut self,
+        webview_id: WebViewId,
+        source_pipeline_id: PipelineId,
+        intersections: Vec<(BrowsingContextId, ViewportIntersection)>,
+    ) {
+        let Some(webview) = self.webviews.get(&webview_id) else {
+            return warn!("{source_pipeline_id}: Viewport intersections for unknown WebView");
+        };
+        for (browsing_context_id, intersection) in intersections {
+            let browsing_context = self.browsing_contexts.get(&browsing_context_id);
+            let pending_changes = webview
+                .pending_changes
+                .iter()
+                .filter(|change| change.browsing_context_id == browsing_context_id);
+            let parent_pipeline_id = match browsing_context {
+                Some(browsing_context) => browsing_context.parent_pipeline_id,
+                None => pending_changes
+                    .clone()
+                    .find_map(|change| change.new_browsing_context_info.as_ref())
+                    .and_then(|info| info.parent_pipeline_id),
+            };
+            if parent_pipeline_id != Some(source_pipeline_id) {
+                warn!(
+                    "{source_pipeline_id}: Ignoring viewport intersection for \
+                    {browsing_context_id}, which it does not contain"
+                );
+                continue;
+            }
+
+            self.viewport_intersections
+                .insert(browsing_context_id, intersection);
+            let pipeline_ids = browsing_context
+                .into_iter()
+                .flat_map(|browsing_context| browsing_context.pipelines.iter().copied())
+                .chain(pending_changes.map(|change| change.new_pipeline_id));
+            for pipeline_id in pipeline_ids {
+                let message =
+                    ScriptThreadMessage::UpdateViewportIntersection(pipeline_id, intersection);
+                if let Some(pipeline) = self.pipelines.get(&pipeline_id) {
+                    let _ = pipeline.event_loop.send(message);
+                }
+            }
+        }
+    }
+
+    /// <https://html.spec.whatwg.org/multipage/#activation-notification>
+    ///
+    /// Notify the ancestors of a fully active document that received a trusted
+    /// activation-triggering input event, and its descendants with the same origin.
+    /// The sending event loop has already updated the documents it can reach locally,
+    /// for which these notifications have no further effect.
+    #[servo_tracing::instrument(skip_all)]
+    fn handle_user_activation_notification(
+        &mut self,
+        source_pipeline_id: PipelineId,
+        time: CrossProcessInstant,
+        origin: ImmutableOrigin,
+    ) {
+        if self.get_activity(source_pipeline_id) != DocumentActivity::FullyActive {
+            return debug!("{source_pipeline_id}: Ignoring activation of an inactive document");
+        }
+        let Some(source) = self.pipelines.get(&source_pipeline_id) else {
+            return;
+        };
+        // An activation cannot start after the notification of its input event.
+        let time = time.min(CrossProcessInstant::now());
+        let browsing_context_id = source.browsing_context_id;
+
+        let ancestors = self
+            .ancestor_pipelines_of_browsing_context_iter(browsing_context_id)
+            .map(|pipeline| (pipeline.id, None));
+        // The originating script thread supplies the document's actual origin, which
+        // can differ from the URL origin for inherited or opaque-origin documents.
+        // Each receiving script thread checks its own document against this origin.
+        let descendants = self
+            .fully_active_descendant_browsing_contexts_iter(browsing_context_id)
+            .filter(move |browsing_context| browsing_context.id != browsing_context_id)
+            .map(move |browsing_context| (browsing_context.pipeline_id, Some(origin.clone())));
+        for (pipeline_id, origin) in ancestors.chain(descendants) {
+            let message = ScriptThreadMessage::NotifyUserActivation(pipeline_id, time, origin);
+            if let Some(pipeline) = self.pipelines.get(&pipeline_id) {
+                let _ = pipeline.event_loop.send(message);
+            }
+        }
+    }
+
+    /// <https://html.spec.whatwg.org/multipage/#consume-user-activation>
+    ///
+    /// Consume the activation of every fully active document in the sender's top-level
+    /// traversable. The sender has already consumed the activation it can reach locally.
+    #[servo_tracing::instrument(skip_all)]
+    fn handle_consume_user_activation(
+        &mut self,
+        webview_id: WebViewId,
+        source_pipeline_id: PipelineId,
+        time: CrossProcessInstant,
+    ) {
+        if self.get_activity(source_pipeline_id) != DocumentActivity::FullyActive ||
+            self.pipelines
+                .get(&source_pipeline_id)
+                .is_none_or(|pipeline| pipeline.webview_id != webview_id)
+        {
+            return debug!("{source_pipeline_id}: Ignoring activation consumption");
+        }
+        let time = time.min(CrossProcessInstant::now());
+        for browsing_context in self.fully_active_browsing_contexts_iter(webview_id) {
+            let pipeline_id = browsing_context.pipeline_id;
+            if pipeline_id == source_pipeline_id {
+                continue;
+            }
+            let message = ScriptThreadMessage::ConsumeUserActivation(pipeline_id, time);
+            if let Some(pipeline) = self.pipelines.get(&pipeline_id) {
+                let _ = pipeline.event_loop.send(message);
+            }
         }
     }
 
