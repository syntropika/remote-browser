{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "strict": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "types": ["bun"],
    "noEmit": true,
    "allowJs": true
  },
  "include": [
    "ui/**/*.ts",
    "ui/**/*.tsx",
    "scripts/**/*.ts",
    "src/host/tests/**/*.ts",
    "src/host/tools/**/*.ts",
    "src/engine/cef/*.ts",
    "test/**/*.ts",
    "src/host/code/**/*.ts",
    "src/engine/src/editor.js"
  ]
}
