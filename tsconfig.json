{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "strict": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "types": ["bun"],
    "noEmit": true
  },
  "include": ["ui/**/*.ts", "ui/**/*.tsx", "scripts/**/*.ts"]
}
