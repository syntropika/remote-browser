 bool ExtensionInstallPromptShowParams::WasParentDestroyed() {
+  // A windowless prompt still belongs to the document that initiated it. An
+  // old page in the back-forward cache must not authorize its replacement.
+  if (initiating_web_contents_.WasInvalidated() ||
+      initiating_page_.WasInvalidated() ||
+      (initiating_page_ && !initiating_page_->IsPrimary())) {
+    return true;
+  }
+
   if (profile_->ShutdownStarted()) {
     return true;
   }
