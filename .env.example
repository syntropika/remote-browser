# Loopback is the default. Use a private host address behind a proxy when needed.
BROWSER_BIND_ADDRESS=127.0.0.1
BROWSER_PORT=8080
# Use the named volume, or replace this with an absolute host directory.
BROWSER_DATA_PATH=browser-data
SCREEN_WIDTH=1280
SCREEN_HEIGHT=800
# Use the owner's actual IANA time zone, for example Europe/Lisbon.
BROWSER_TIMEZONE=UTC
# For an HTTPS reverse proxy, set its exact external origin (no trailing slash).
# PUBLIC_ORIGIN=https://browser.example.com
