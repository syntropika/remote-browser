{
  "name": "remote-browser",
  "version": "0.1.0",
  "private": true,
  "description": "A browser an agent and a person share, driven through CEF and reachable over MCP.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/syntropika/remote-browser.git"
  },
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build-ui.ts",
    "build:engine": "bun run scripts/prepare-cef.ts --build",
    "prepare:cef": "bun run scripts/prepare-cef.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:unit && bun run test:host",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "lint:fix": "oxlint --fix --deny-warnings --report-unused-disable-directives",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "bun run format:check && bun run typecheck && bun run lint && bun run test",
    "build:host": "bun run scripts/tasks.ts build:host",
    "test:unit": "bun test scripts test",
    "test:host": "bun run scripts/tasks.ts test:host",
    "test:integration": "bun run scripts/integration.ts",
    "lint:host": "bun run scripts/tasks.ts lint:host"
  },
  "dependencies": {
    "@heroui/react": "3.2.6",
    "@internationalized/date": "3.12.4",
    "@react-aria/ssr": "3.10.1",
    "@react-aria/utils": "3.34.1",
    "react": "19.3.1",
    "react-aria": "3.52.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.1.18",
    "@types/bun": "1.3.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "tailwindcss": "4.1.18",
    "tar": "7.5.22",
    "typescript": "5.9.3",
    "ultracite": "7.12.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
