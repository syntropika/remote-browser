{
  "name": "remote-browser",
  "version": "0.1.0",
  "private": true,
  "description": "A persistent Chromium browser with MCP automation and human remote control.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/syntropika/remote-browser.git"
  },
  "type": "module",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "start": "node dist/src/server.js",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "node dist/scripts/integration.js",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "lint:fix": "oxlint --fix --deny-warnings --report-unused-disable-directives",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@novnc/novnc": "1.7.0",
    "@playwright/mcp": "0.0.83",
    "effect": "4.0.0",
    "playwright": "1.64.0-alpha-1790635538000",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "ultracite": "7.12.0"
  },
  "engines": {
    "node": ">=24"
  }
}
